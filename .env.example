# Токен сообщества (Настройки -> Работа с API -> Ключи доступа)
VK_TOKEN=

# ID сообщества (число, без минуса)
VK_GROUP_ID=

# Часовой пояс для статистики (день/час считаются в нём)
BOT_TZ=Europe/Moscow

# Пути (по умолчанию можно не менять)
DB_PATH=data/stats.db
EXPORT_PATH=data/export.txt

# Письмо о падении бота (не задано — уведомления выключены)
# Для Gmail: включить 2FA и создать пароль приложения на myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Куда слать (пусто — на SMTP_USER)
NOTIFY_EMAIL=

# VK id, кому слать ЛС о падении из сообщества (число из vk.com/idXXXXX)
NOTIFY_VK_ID=
